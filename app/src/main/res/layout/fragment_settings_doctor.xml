<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settingsDoctorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".controller.user.home.SettingsFragment">


        <TextView
            android:id="@+id/settingsDoctorTitle"
            android:layout_width="wrap_content"
            android:fadeScrollbars="false"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/marginLeftSettings"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/titillium_web_bold"
            android:text="@string/settingsUpperCase"
            android:textSize="@dimen/textSettingsTitle"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/evalutationAppTitleDoctor"
            android:layout_width="264dp"
            android:layout_height="33dp"
            android:layout_marginLeft="@dimen/marginLeftSettings"
            android:layout_marginTop="20dp"
            android:fadeScrollbars="false"
            android:fontFamily="@font/titillium_web_bold"
            android:text="@string/evalutationAppTitle"
            android:textSize="@dimen/textSettingsOption"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/settingsDoctorTitle" />

        <RatingBar
            android:id="@+id/ratingAppDoctor"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:stepSize="0.5"
            android:rating="0"
            android:layout_marginTop="20dp"
            android:numStars="5"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginLeft="@dimen/marginLeftSettings"
            app:layout_constraintTop_toBottomOf="@+id/evalutationAppTitleDoctor"/>

        <TextView
            android:id="@+id/valueRatingAppDoctor"
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/marginBetweenInputs"
            android:layout_marginLeft="@dimen/marginLeftSettings"
            android:textSize="20dp"
            app:layout_constraintTop_toBottomOf="@+id/evalutationAppTitleDoctor"
            app:layout_constraintLeft_toRightOf="@+id/ratingAppDoctor"
            android:layout_height="wrap_content"/>


        <View
            android:id="@+id/greyLine2"
            android:layout_width="match_parent"
            android:layout_marginTop="30dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:backgroundTint="#dbdbdb"
            android:background="@color/greyLine"
            android:layout_marginLeft="@dimen/marginLeftSettings"
            android:layout_marginRight="@dimen/marginRightSettings"
            app:layout_constraintTop_toBottomOf="@+id/ratingAppDoctor"
            android:layout_height="2dp">
        </View>

        <TextView
            android:id="@+id/exitAccountTitleDoctor"
            android:layout_width="270dp"
            android:fadeScrollbars="false"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/marginLeftSettings"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/titillium_web_bold"
            android:text="@string/exitAccountTitle"
            android:textSize="@dimen/textSettingsOption"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/greyLine2" />

        <Button
            android:id="@+id/exitAccountButtonDoctor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/marginBetweenInputs"
            android:backgroundTint="@color/red"
            android:text="@string/exit"
            android:layout_marginLeft="@dimen/marginLeftSettings"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/exitAccountTitleDoctor"></Button>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="3dp"
            android:text="version 1.0"
            android:textStyle="italic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent" />



    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
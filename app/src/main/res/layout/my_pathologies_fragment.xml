<?xml version="1.0" encoding="utf-8"?>


<ScrollView android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".controller.patient.home.MyPathologiesFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/diabetisLayout"
            android:layout_width="match_parent"
            android:elevation="10dp"
            android:background="@color/colorHealthHistory"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_height="@dimen/heightHealthHistory"
            android:layout_marginStart="@dimen/marginHealthHistory"
            android:layout_marginTop="@dimen/marginTopHealthHistory"
            android:layout_marginEnd="@dimen/marginHealthHistory"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginLeft="@dimen/marginBetweenInputs"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/diabetisTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/diabete"
                android:textColor="@color/white"
                android:textSize="@dimen/textTitleHealthHistory"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/diabetisLastVisitLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="2dp"
                android:text="@string/lastVisitLabel"
                android:textColor="@color/white"
                android:textSize="13dp"
                app:layout_constraintTop_toBottomOf="@+id/diabetisTitle"
                app:layout_constraintLeft_toLeftOf="parent" />


            <TextView
                android:id="@+id/diabetisLastVisit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginTop="2dp"
                android:text="20/10/2023"
                android:textColor="@color/white"
                android:textSize="13dp"
                app:layout_constraintTop_toBottomOf="@+id/diabetisTitle"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintStart_toEndOf="@+id/diabetisLastVisitLabel" />

            <TextView
                android:id="@+id/diabetisLevelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                android:text="Priorità: alta 🔴"
                android:textColor="@color/white"
                android:textSize="13dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/diabetisLastVisit" />

        </androidx.constraintlayout.widget.ConstraintLayout>



        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dermatitisLayout"
            android:layout_width="match_parent"
            android:elevation="10dp"
            android:background="@color/colorHealthHistory"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_height="@dimen/heightHealthHistory"
            android:layout_marginStart="@dimen/marginHealthHistory"
            android:layout_marginTop="@dimen/marginTopHealthHistory"
            android:layout_marginEnd="@dimen/marginHealthHistory"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            android:layout_marginLeft="@dimen/marginBetweenInputs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/diabetisLayout">

            <TextView
                android:id="@+id/dermatitisTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@+id/dermatitisLayout"
                app:layout_constraintLeft_toLeftOf="@+id/dermatitisLayout"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="20dp"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/dermatitis"
                android:textSize="@dimen/textTitleHealthHistory"
                android:textColor="@color/white"/>

            <TextView
                android:id="@+id/dermatitisLastVisitLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="2dp"
                android:text="@string/lastVisitLabel"
                android:textColor="@color/white"
                android:textSize="13dp"
                app:layout_constraintTop_toBottomOf="@+id/dermatitisTitle"
                app:layout_constraintLeft_toLeftOf="parent" />


            <TextView
                android:id="@+id/dermatitisLastVisit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="5dp"
                android:text="10/05/2023"
                android:textColor="@color/white"
                android:textSize="13dp"
                app:layout_constraintTop_toBottomOf="@+id/dermatitisTitle"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dermatitisLastVisitLabel" />


            <TextView
                android:id="@+id/dermatitisLevelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                android:text="Priorità: media 🟠"
                android:textColor="@color/white"
                android:textSize="13dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dermatitisLastVisit" />
        </androidx.constraintlayout.widget.ConstraintLayout>





        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bronchitisLayout"
            android:elevation="10dp"
            android:layout_width="match_parent"
            android:background="@color/colorHealthHistory"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_height="@dimen/heightHealthHistory"
            android:layout_marginStart="@dimen/marginHealthHistory"
            android:layout_marginTop="@dimen/marginTopHealthHistory"
            android:layout_marginEnd="@dimen/marginHealthHistory"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            android:layout_marginLeft="@dimen/marginBetweenInputs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dermatitisLayout">

            <TextView
                android:id="@+id/bronchitisTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="20dp"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/brochitis"
                android:textSize="@dimen/textTitleHealthHistory"
                android:textColor="@color/white"/>


            <TextView
                android:id="@+id/bronchitisLastVisitLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="5dp"
                android:text="@string/lastVisitLabel"
                android:textColor="@color/white"
                android:textSize="13dp"
                app:layout_constraintTop_toBottomOf="@+id/bronchitisTitle"
                app:layout_constraintLeft_toLeftOf="parent" />


            <TextView
                android:id="@+id/bronchitisLastVisit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginTop="5dp"
                android:text="20/10/2022"
                android:textColor="@color/white"
                android:textSize="13dp"
                app:layout_constraintTop_toBottomOf="@+id/bronchitisTitle"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintStart_toEndOf="@+id/bronchitisLastVisitLabel" />

            <TextView
                android:id="@+id/bronchitisLevelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                android:text="Priorità: bassa 🟢"
                android:textColor="@color/white"
                android:textSize="13dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bronchitisLastVisit" />

        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

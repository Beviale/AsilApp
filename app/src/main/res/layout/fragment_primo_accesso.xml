<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appBackground"
    android:orientation="vertical"
    tools:context=".PrimoAccesso">

    <TextView
        android:id="@+id/loginLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:text="@string/loginFragmentTitle"
        android:textAlignment="center"
        android:textColor="@color/titleColor"
        android:textSize="@dimen/title1FontSize" />

    <EditText
        android:id="@+id/nameInput"
        android:layout_width="@dimen/inputTextWidth"
        android:layout_height="@dimen/inpuTextHeight"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/marginBetweenInputs"
        android:ems="10"
        android:hint="@string/namePlaceholder"
        android:inputType="text"
        android:textColorHint="@color/textPlaceholderColor"
        android:textSize="@dimen/textInputFontSize" />

    <EditText
        android:id="@+id/surnameImput"
        android:layout_width="@dimen/inputTextWidth"
        android:layout_height="@dimen/inpuTextHeight"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/marginBetweenInputs"
        android:ems="10"
        android:hint="@string/namePlaceholder"
        android:inputType="text"
        android:textColorHint="@color/textPlaceholderColor"
        android:textSize="@dimen/textInputFontSize" />

    <Button
        android:id="@+id/buttonLogin"
        android:layout_width="@dimen/buttonsLoginWidth"
        android:layout_height="@dimen/buttonsLoginHeight"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/marginBetweenInputs"
        android:backgroundTint="@color/buttonsColor"
        android:text="@string/loginButtonLabel"
        android:textColor="@color/textColorOnButton" />

    <Button
        android:id="@+id/buttonRegister"
        android:layout_width="@dimen/buttonsLoginWidth"
        android:layout_height="@dimen/buttonsLoginHeight"
        android:layout_gravity="center"
        android:backgroundTint="@color/buttonsColor"
        android:text="@string/loginRegistrationButtonLabel"
        android:textColor="@color/textColorOnButton" />

    <Button
        android:id="@+id/buttonProfessor"
        android:layout_width="@dimen/buttonsLoginWidth"
        android:layout_height="@dimen/buttonsLoginHeight"
        android:layout_gravity="center"
        android:backgroundTint="@color/buttonsColor"
        android:text="@string/loginFragmentProfLabel"
        android:textColor="@color/textColorOnButton" />
</LinearLayout>
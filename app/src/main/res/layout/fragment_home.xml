<?xml version="1.0" encoding="utf-8"?>


<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".view.home.HomeFragment">


        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/titillium_web_bold"
            android:text="@string/welcome"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:textSize="@dimen/title2FontSize" />


        <ImageView
            android:layout_width="78dp"
            android:layout_height="75dp"
            android:layout_marginRight="30dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/users"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="411dp" />


        <TextView
            android:id="@+id/textVideoSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:textSize="@dimen/title3FontSize"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="@dimen/marginTopFragmentHome"
            android:fontFamily="@font/titillium_web_bold"
            android:text="Video"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcomeText" />


        <HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/scrollBarVideo"
            android:layout_width="match_parent"
            android:fadeScrollbars="false"
            android:layout_height="200dp"
            android:scrollbars="horizontal"
            android:layout_marginTop="0dp"
            app:layout_constraintTop_toBottomOf="@+id/textVideoSection">

            <LinearLayout
                android:id="@+id/xml_full_img_linear_below_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">


            <WebView
                android:id="@+id/firstVideoView"
                android:layout_width="300dp"
                android:layout_height="match_parent" />

                <WebView
                    android:id="@+id/secondVideoView"
                    android:layout_width="300dp"
                    android:layout_height="match_parent" />

            </LinearLayout>



        </HorizontalScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
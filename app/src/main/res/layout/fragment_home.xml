<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/swipereFreshLayoutHomeFragment"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".controller.user.home.HomeFragment">


            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/welcome"
                android:textSize="@dimen/title2FontSize"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <ImageView
                android:layout_width="78dp"
                android:layout_height="75dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="30dp"
                android:src="@drawable/users"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:layout_editor_absoluteX="411dp" />


            <TextView
                android:id="@+id/textVideoSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:layout_marginTop="@dimen/marginTopBetweenSectionHome"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/video"
                android:textSize="@dimen/title3FontSize"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/welcomeText" />


            <FrameLayout
                android:id="@+id/frameLayoutVideoHome"
                android:layout_width="match_parent"
                android:layout_marginTop="0dp"
                app:layout_constraintTop_toBottomOf="@+id/textVideoSection"
                android:layout_height="match_parent">

                <HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
                    android:id="@+id/scrollBarVideo"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="0dp"
                    android:fadeScrollbars="false"
                    android:scrollbarSize="2dp"
                    android:scrollbars="horizontal">

                    <LinearLayout
                        android:id="@+id/layoutVideo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">
                        <WebView
                            android:id="@+id/firstVideoView"
                            android:layout_width="@dimen/widthVideoHome"
                            android:layout_height="match_parent" />
                        <WebView
                            android:id="@+id/secondVideoView"
                            android:layout_width="@dimen/widthVideoHome"
                            android:layout_height="match_parent" />
                    </LinearLayout>
                </HorizontalScrollView>

                <ProgressBar
                    android:id="@+id/progressBarVideoHome"
                    android:layout_width="@dimen/progressBarDim"
                    android:backgroundTint="@color/appMainColor"
                    android:indeterminateTint="@color/appMainColor"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_height="@dimen/progressBarDim"/>
            </FrameLayout>




            <TextView
                android:id="@+id/tipsHomeSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:layout_marginTop="@dimen/marginTopBetweenSectionHome"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/tips"
                android:textSize="@dimen/title3FontSize"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frameLayoutVideoHome" />


            <ImageView
                android:id="@+id/arrowToAllTipsFragment"
                android:layout_width="@dimen/arrowDimen"
                android:layout_height="@dimen/arrowDimen"
                android:layout_marginTop="15dp"
                android:layout_marginRight="30dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:padding="@dimen/arrowPadding"
                android:src="@mipmap/arrow_forward"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frameLayoutVideoHome" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/firstCardTips"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:layout_marginTop="20dp"
                android:layout_marginRight="30dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_cards"
                android:elevation="10dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tipsHomeSection">

                <ImageView
                    android:id="@+id/imageNutritionalTips"
                    android:layout_width="match_parent"
                    android:src="@drawable/nutrition"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_height="130dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:padding="10dp"
                    android:fontFamily="@font/titillium_web_bold"
                    android:text="Come mangiare sano senza morire di fame"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/rounded_cards"
                    android:elevation="30dp"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/secondCardTips"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_marginTop="20dp"
                android:layout_marginRight="30dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_cards"
                android:elevation="10dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/firstCardTips">

                <ImageView
                    android:id="@+id/imageWelnessTips"
                    android:layout_width="match_parent"
                    android:src="@drawable/welness"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_height="130dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:padding="10dp"
                    android:fontFamily="@font/titillium_web_bold"
                    android:text="100 consigli per migliorare il tuo benessere"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/rounded_cards"
                    android:elevation="30dp"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/outgoingsHomeSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:layout_marginTop="@dimen/marginTopBetweenSectionHome"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/outgoingsManagement"
                android:textSize="@dimen/title3FontSize"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/secondCardTips" />


            <ImageView
                android:id="@+id/arrowToOutgoingsFragment"
                android:layout_width="@dimen/arrowDimen"
                android:layout_height="@dimen/arrowDimen"
                android:layout_marginTop="13dp"
                android:layout_marginRight="30dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:padding="@dimen/arrowPadding"
                android:src="@mipmap/arrow_forward"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/secondCardTips" />

            <FrameLayout
                android:id="@+id/frameLayoutChartHome"
                android:layout_width="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/outgoingsHomeSection"
                android:layout_marginTop="20dp"
                android:layout_height="match_parent">

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pieChartHome"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:layout_marginRight= "@dimen/marginLeftHome"

                android:layout_width="@dimen/pieChart"
                android:layout_height="@dimen/pieChart" />

                <ProgressBar
                    android:id="@+id/progressBarChartHome"
                    android:layout_width="@dimen/progressBarDim"
                    android:backgroundTint="@color/appMainColor"
                    android:indeterminateTint="@color/appMainColor"
                    android:visibility="gone"
                    android:layout_gravity="center"
                    android:layout_height="@dimen/progressBarDim"/>
            </FrameLayout>

            <TextView
                android:id="@+id/phoneNumberHomeSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:layout_marginTop="@dimen/marginTopBetweenSectionHome"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/usefulPhoneNumbers"
                android:textSize="@dimen/title3FontSize"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frameLayoutChartHome" />

            <ImageView
                android:id="@+id/policeNumberImage"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:layout_width="40dp"
                android:src="@drawable/phone_call"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginLeft="@dimen/marginLeftHome"
                app:layout_constraintTop_toBottomOf="@+id/phoneNumberHomeSection"
                android:layout_marginTop="30dp"
                android:layout_height="40dp"/>

            <TextView
                android:id="@+id/policeNumberText"
                android:layout_width="wrap_content"
                android:textSize="@dimen/title3FontSize"
                app:layout_constraintTop_toBottomOf="@+id/phoneNumberHomeSection"
                android:layout_marginTop="20dp"
                android:text="@string/emergencyNumber"
                app:layout_constraintLeft_toRightOf="@+id/policeNumberImage"
                android:layout_marginLeft="10dp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/policeNumberValue"
                android:layout_width="wrap_content"
                android:textSize="@dimen/title3FontSize"
                android:textColor="@color/red"
                app:layout_constraintTop_toBottomOf="@+id/policeNumberText"
                android:layout_marginTop="5dp"
                android:text="112"
                app:layout_constraintLeft_toRightOf="@+id/policeNumberImage"
                android:layout_marginLeft="10dp"
                android:layout_height="wrap_content"/>


            <ImageView
                android:id="@+id/unhcrNumberImage"
                android:layout_width="40dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:src="@drawable/phone_call"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginLeft="@dimen/marginLeftHome"
                app:layout_constraintTop_toBottomOf="@+id/policeNumberImage"
                android:layout_marginTop="30dp"
                android:layout_height="40dp"/>

            <TextView
                android:id="@+id/unhcrNumberText"
                android:layout_width="wrap_content"
                android:textSize="@dimen/title3FontSize"
                app:layout_constraintTop_toBottomOf="@+id/policeNumberImage"
                android:layout_marginTop="20dp"
                android:text="@string/emergencyNumberUnhcr"
                app:layout_constraintLeft_toRightOf="@+id/unhcrNumberImage"
                android:layout_marginLeft="10dp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/unchrNumberValue"
                android:layout_width="wrap_content"
                android:textSize="@dimen/title3FontSize"
                android:textColor="@color/appMainColor"
                app:layout_constraintTop_toBottomOf="@+id/unhcrNumberText"
                android:layout_marginTop="5dp"
                android:text="800905570"
                app:layout_constraintLeft_toRightOf="@+id/unhcrNumberImage"
                android:layout_marginLeft="10dp"
                android:layout_height="wrap_content"/>




            <ImageView
                android:id="@+id/commissionNumberImage"
                android:layout_width="40dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:src="@drawable/phone_call"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginLeft="@dimen/marginLeftHome"
                app:layout_constraintTop_toBottomOf="@+id/unhcrNumberImage"
                android:layout_marginTop="30dp"
                android:layout_height="40dp"/>

            <TextView
                android:id="@+id/commissionNumberText"
                android:layout_width="wrap_content"
                android:textSize="@dimen/title3FontSize"
                app:layout_constraintTop_toBottomOf="@+id/unhcrNumberImage"
                android:layout_marginTop="20dp"
                android:text="@string/emergencyNumberCommission"
                app:layout_constraintLeft_toRightOf="@+id/commissionNumberImage"
                android:layout_marginLeft="10dp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/commissionNumberValue"
                android:layout_width="wrap_content"
                android:textSize="@dimen/title3FontSize"
                android:textColor="@color/appMainColor"
                app:layout_constraintTop_toBottomOf="@+id/commissionNumberText"
                android:layout_marginTop="5dp"
                android:text="06 69000100"
                app:layout_constraintLeft_toRightOf="@+id/commissionNumberImage"
                android:layout_marginLeft="10dp"
                android:layout_height="wrap_content"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/swipereFreshLayoutHomeFragment"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:android="http://schemas.android.com/apk/res/android">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".controller.user.home.HomeFragment">


            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/welcome"
                android:textSize="@dimen/title2FontSize"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <ImageView
                android:layout_width="78dp"
                android:layout_height="75dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="30dp"
                android:src="@drawable/users"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:layout_editor_absoluteX="411dp" />


            <TextView
                android:id="@+id/textVideoSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:layout_marginTop="@dimen/marginTopBetweenSectionHome"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/video"
                android:textSize="@dimen/title3FontSize"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/welcomeText" />



            <HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/scrollBarVideo"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="0dp"
                android:fadeScrollbars="false"
                android:scrollbarSize="2dp"
                android:scrollbars="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/textVideoSection">

                <LinearLayout
                    android:id="@+id/layoutVideo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <WebView
                        android:id="@+id/firstVideoView"
                        android:layout_width="@dimen/widthVideoHome"
                        android:layout_height="match_parent" />
                    <WebView
                        android:id="@+id/secondVideoView"
                        android:layout_width="@dimen/widthVideoHome"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </HorizontalScrollView>



            <TextView
                android:id="@+id/tipsHomeSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:layout_marginTop="@dimen/marginTopBetweenSectionHome"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/tips"
                android:textSize="@dimen/title3FontSize"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/scrollBarVideo" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardNutritionalTips"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:layout_marginTop="20dp"
                android:layout_marginRight="30dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_cards"
                android:elevation="10dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tipsHomeSection">

                <ImageView
                    android:id="@+id/imageNutritionalTips"
                    android:layout_width="match_parent"
                    android:src="@drawable/nutrition"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_height="130dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:padding="10dp"
                    android:fontFamily="@font/titillium_web_bold"
                    android:text="Come mangiare sano senza morire di fame"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/rounded_cards"
                    android:elevation="30dp"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardWelnessTips"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_marginTop="20dp"
                android:layout_marginRight="30dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_cards"
                android:elevation="10dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardNutritionalTips">

                <ImageView
                    android:id="@+id/imageWelnessTips"
                    android:layout_width="match_parent"
                    android:src="@drawable/welness"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_height="130dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:padding="10dp"
                    android:fontFamily="@font/titillium_web_bold"
                    android:text="100 consigli per migliorare il tuo benessere"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/rounded_cards"
                    android:elevation="30dp"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/outgoingsHomeSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:layout_marginLeft="@dimen/marginLeftHome"
                android:layout_marginTop="@dimen/marginTopBetweenSectionHome"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/outgoingsManagement"
                android:textSize="@dimen/title3FontSize"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardWelnessTips" />


            <ImageView
                android:id="@+id/arrowToOutgoingsFragment"
                android:layout_width="@dimen/arrowDimen"
                android:layout_height="@dimen/arrowDimen"
                android:layout_marginTop="13dp"
                android:layout_marginRight="30dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:padding="@dimen/arrowPadding"
                android:src="@mipmap/arrow_forward"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardWelnessTips" />

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pieChartHome"
                android:layout_width="@dimen/pieChart"
                android:layout_height="@dimen/pieChart"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/outgoingsHomeSection" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="false"
    android:scrollbars="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutOldHealthHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".controller.user.home.DetailHealthHistoryFragment">


        <TextView
            android:id="@+id/detailHealthHistoryTitleOld"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/marginLeftRightDetailHealthHistory"
            android:layout_marginTop="28dp"
            android:layout_marginRight="@dimen/marginLeftRightDetailHealthHistory"
            android:fadeScrollbars="false"
            android:fontFamily="@font/titillium_web_bold"
            android:text="@string/iAmLoading"
            android:textSize="@dimen/textDetailHealthHistoryTitle"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/iconDetailTitleOld"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iconDetailTitleOld"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/medical_history_old"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toEndOf="@+id/detailHealthHistoryTitleOld"
            app:layout_constraintTop_toTopOf="parent">

        </ImageView>

        <TextView
            android:id="@+id/recordHealthHistoryOld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/titillium_web_bold"
            android:text="@string/recordHealthHistoryOld"
            android:textSize="25dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailHealthHistoryTitleOld" />


        <ImageView
            android:id="@+id/shareDetailHealthHistoryOld"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="28dp"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:padding="7dp"
            android:src="@drawable/share_fill0_wght400_grad0_opsz24"
            app:layout_constraintLeft_toRightOf="@+id/recordHealthHistoryOld"
            app:layout_constraintTop_toBottomOf="@+id/detailHealthHistoryTitleOld" />



        <TextView
            android:id="@+id/idRecordHealthHistoryLabelOld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
            android:layout_marginTop="5dp"
            android:text="@string/idLastRecordHealthHistoryLabel"
            android:textSize="@dimen/valueDetailHealthHistory"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recordHealthHistoryOld"/>

        <TextView
            android:id="@+id/idRecordHealthHistoryOld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:text="@string/iAmLoading"
            android:textSize="@dimen/valueDetailHealthHistory"
            app:layout_constraintLeft_toRightOf="@+id/idRecordHealthHistoryLabelOld"
            app:layout_constraintTop_toBottomOf="@+id/recordHealthHistoryOld" />

        <TextView
            android:id="@+id/dateRecordHealthHistoryLabelOld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
            android:layout_marginTop="5dp"
            android:text="@string/dateLastRecordHealthHistoryLabel"
            android:textSize="@dimen/valueDetailHealthHistory"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/idRecordHealthHistoryLabelOld" />

        <TextView
            android:id="@+id/dateRecordHealthHistoryOld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:text="@string/iAmLoading"
            android:textSize="@dimen/valueDetailHealthHistory"
            app:layout_constraintLeft_toRightOf="@+id/dateRecordHealthHistoryLabelOld"
            app:layout_constraintTop_toBottomOf="@+id/idRecordHealthHistoryLabelOld" />


        <TextView
            android:id="@+id/timeRecordHealthHistoryLabelOld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
            android:layout_marginTop="5dp"
            android:text="@string/timeLastRecordHealthHistoryLabel"
            android:textSize="@dimen/valueDetailHealthHistory"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dateRecordHealthHistoryOld" />

        <TextView
            android:id="@+id/timeRecordHealthHistoryOld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:text="@string/iAmLoading"
            android:textSize="@dimen/valueDetailHealthHistory"
            app:layout_constraintLeft_toRightOf="@+id/timeRecordHealthHistoryLabelOld"
            app:layout_constraintTop_toBottomOf="@+id/dateRecordHealthHistoryOld" />



        <TextView
            android:id="@+id/valueRecordHealthHistoryLabelOld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="5dp"
            android:text="@string/valueLastRecordHealthHistoryLabel"
            android:textSize="@dimen/valueDetailHealthHistory"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/timeRecordHealthHistoryOld" />

        <TextView
            android:id="@+id/valueLastRecordHealthHistoryOld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:text="@string/iAmLoading"
            android:textSize="@dimen/valueDetailHealthHistory"
            app:layout_constraintLeft_toRightOf="@+id/valueRecordHealthHistoryLabelOld"
            app:layout_constraintTop_toBottomOf="@+id/timeRecordHealthHistoryOld" />


        <TextView
            android:id="@+id/evalutationRecordHealthHistoryLabelOld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
            android:layout_marginTop="5dp"
            android:text="@string/evalutationLastRecordHealthHistoryLabel"
            android:textSize="@dimen/valueDetailHealthHistory"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/valueLastRecordHealthHistoryOld" />

        <TextView
            android:id="@+id/evalutationRecordHealthHistoryOld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:text="@string/iAmLoading"
            android:textSize="@dimen/valueDetailHealthHistory"
            app:layout_constraintLeft_toRightOf="@+id/evalutationRecordHealthHistoryLabelOld"
            app:layout_constraintTop_toBottomOf="@+id/valueLastRecordHealthHistoryOld" />



        <TextView
            android:id="@+id/doctorNotesRecordHealthHistoryLabelOld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
            android:layout_marginTop="5dp"
            android:text="@string/doctorNotesLastRecordHealthHistoryLabel"
            android:textSize="@dimen/valueDetailHealthHistory"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/evalutationRecordHealthHistoryOld" />


        <EditText
            android:id="@+id/doctorNotesRecordHealthHistoryOld"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="@dimen/marginLeftRightDetailHealthHistory"
            android:background="@drawable/rounded"
            android:cursorVisible="true"
            android:editable="false"
            android:elevation="10dp"
            android:fadeScrollbars="false"
            android:padding="10dp"
            android:scrollbarAlwaysDrawHorizontalTrack="false"
            android:scrollbarAlwaysDrawVerticalTrack="false"
            android:scrollbars="vertical"
            android:text="@string/iAmLoading"
            android:textSize="@dimen/textSizeDoctorNotes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/doctorNotesRecordHealthHistoryLabelOld" />



    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
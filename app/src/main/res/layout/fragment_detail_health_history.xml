<?xml version="1.0" encoding="utf-8"?>

<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/swipereFreshLayoutDetailHealthHistory"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:nestedScrollingEnabled="true"
        android:fadeScrollbars="false"
        android:scrollbars="vertical"
        xmlns:android="http://schemas.android.com/apk/res/android">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/detailHealthHistoryLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".controller.user.home.DetailHealthHistoryFragment">


            <TextView
                android:id="@+id/detailHealthHistoryTitle"
                android:layout_width="270dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/marginLeftRightDetailHealthHistory"
                android:layout_marginTop="28dp"
                android:layout_marginRight="10dp"
                android:fadeScrollbars="false"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/iAmLoading"
                android:textSize="@dimen/textDetailHealthHistoryTitle"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/iconDetailTitle"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iconDetailTitle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="20dp"
                android:src="@drawable/medical_history"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toEndOf="@+id/detailHealthHistoryTitle"
                app:layout_constraintTop_toTopOf="parent">

            </ImageView>

            <TextView
                android:id="@+id/lastRecordHealthHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/titillium_web_bold"
                android:text="@string/lastRecordHealtHistory"
                android:textSize="25dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/detailHealthHistoryTitle" />


            <ImageView
                android:id="@+id/shareDetailHealthHistory"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="28dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:padding="7dp"
                android:src="@drawable/share_fill0_wght400_grad0_opsz24"
                app:layout_constraintLeft_toRightOf="@+id/lastRecordHealthHistory"
                app:layout_constraintTop_toBottomOf="@+id/detailHealthHistoryTitle" />



            <TextView
                android:id="@+id/idLastRecordHealthHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
                android:layout_marginTop="5dp"
                android:text="@string/idLastRecordHealthHistoryLabel"
                android:textSize="@dimen/valueDetailHealthHistory"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lastRecordHealthHistory" />

            <TextView
                android:id="@+id/idLastRecordHealthHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:text="@string/iAmLoading"
                android:textSize="@dimen/valueDetailHealthHistory"
                app:layout_constraintLeft_toRightOf="@+id/idLastRecordHealthHistoryLabel"
                app:layout_constraintTop_toBottomOf="@+id/lastRecordHealthHistory" />

            <TextView
                android:id="@+id/dateLastRecordHealthHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
                android:layout_marginTop="5dp"
                android:text="@string/dateLastRecordHealthHistoryLabel"
                android:textSize="@dimen/valueDetailHealthHistory"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/idLastRecordHealthHistoryLabel" />

            <TextView
                android:id="@+id/dateLastRecordHealthHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:text="@string/iAmLoading"
                android:textSize="@dimen/valueDetailHealthHistory"
                app:layout_constraintLeft_toRightOf="@+id/dateLastRecordHealthHistoryLabel"
                app:layout_constraintTop_toBottomOf="@+id/idLastRecordHealthHistoryLabel" />


            <TextView
                android:id="@+id/timeLastRecordHealthHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
                android:layout_marginTop="5dp"
                android:text="@string/timeLastRecordHealthHistoryLabel"
                android:textSize="@dimen/valueDetailHealthHistory"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dateLastRecordHealthHistory" />

            <TextView
                android:id="@+id/timeLastRecordHealthHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:text="@string/iAmLoading"
                android:textSize="@dimen/valueDetailHealthHistory"
                app:layout_constraintLeft_toRightOf="@+id/timeLastRecordHealthHistoryLabel"
                app:layout_constraintTop_toBottomOf="@+id/dateLastRecordHealthHistory" />



            <TextView
                android:id="@+id/valueLastRecordHealthHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="5dp"
                android:text="@string/valueLastRecordHealthHistoryLabel"
                android:textSize="@dimen/valueDetailHealthHistory"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/timeLastRecordHealthHistory" />

            <TextView
                android:id="@+id/valueLastRecordHealthHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:text="@string/iAmLoading"
                android:textSize="@dimen/valueDetailHealthHistory"
                app:layout_constraintLeft_toRightOf="@+id/valueLastRecordHealthHistoryLabel"
                app:layout_constraintTop_toBottomOf="@+id/timeLastRecordHealthHistory" />





            <TextView
                android:id="@+id/evalutationLastRecordHealthHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
                android:layout_marginTop="5dp"
                android:text="@string/evalutationLastRecordHealthHistoryLabel"
                android:textSize="@dimen/valueDetailHealthHistory"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/valueLastRecordHealthHistory" />

            <TextView
                android:id="@+id/evalutationLastRecordHealthHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:text="@string/iAmLoading"
                android:textSize="@dimen/valueDetailHealthHistory"
                app:layout_constraintLeft_toRightOf="@+id/evalutationLastRecordHealthHistoryLabel"
                app:layout_constraintTop_toBottomOf="@+id/valueLastRecordHealthHistory" />


            <ImageView
                android:id="@+id/editButtonHealthHistoryEvalutation"
                android:layout_width="29dp"
                android:layout_height="24dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:elevation="30dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:src="@drawable/edit"
                android:visibility="gone"
                app:layout_constraintLeft_toRightOf="@+id/evalutationLastRecordHealthHistory"
                app:layout_constraintTop_toBottomOf="@+id/valueLastRecordHealthHistory" />

            <TextView
                android:id="@+id/doctorNotesLastRecordHealthHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
                android:layout_marginTop="5dp"
                android:text="@string/doctorNotesLastRecordHealthHistoryLabel"
                android:textSize="@dimen/valueDetailHealthHistory"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/evalutationLastRecordHealthHistory" />

            <ImageView
                android:id="@+id/editButtonHealthHistoryDoctorNotes"
                android:layout_width="29dp"
                android:layout_height="24dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:elevation="30dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:src="@drawable/edit"
                android:visibility="gone"
                app:layout_constraintLeft_toRightOf="@+id/doctorNotesLastRecordHealthHistoryLabel"
                app:layout_constraintTop_toBottomOf="@+id/evalutationLastRecordHealthHistory" />


            <EditText
                android:id="@+id/doctorNotesLastRecordHealthHistory"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/marginLeftRightDetailHealthHistory"
                android:background="@drawable/rounded"
                android:cursorVisible="true"
                android:editable="false"
                android:elevation="10dp"
                android:gravity="top|left"
                android:fadeScrollbars="false"
                android:padding="10dp"
                android:scrollbarAlwaysDrawHorizontalTrack="false"
                android:scrollbarAlwaysDrawVerticalTrack="false"
                android:scrollbars="vertical"
                android:text="@string/iAmLoading"
                android:textSize="@dimen/textSizeDoctorNotes"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/doctorNotesLastRecordHealthHistoryLabel" />


            <TextView
                android:layout_width="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/blackLine"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginLeft="@dimen/marginLeftRightDetailHealthHistory"
                android:textColor="@color/white"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@color/appMainColorDark"
                android:text="@string/previousFindings"
                android:layout_height="wrap_content">
            </TextView>

            <View
                android:id="@+id/blackLine"
                app:layout_constraintTop_toBottomOf="@+id/doctorNotesLastRecordHealthHistory"
                android:background="@color/appMainColorDark"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
                android:layout_marginEnd="@dimen/marginLeftRightDetailHealthHistory"
                android:layout_marginTop="70dp"
                android:layout_width = "match_parent"
                android:layout_height="5dp"/>







                <View
                    android:layout_width="match_parent"
                    android:background="@color/appMainColorDark"
                    android:layout_height="2dp"></View>

            <FrameLayout
                android:layout_width="match_parent"
                app:layout_constraintTop_toBottomOf="@+id/blackLine"
                android:layout_marginLeft="@dimen/marginLeftRightDetailHealthHistory"
                android:layout_marginRight="@dimen/marginLeftRightDetailHealthHistory"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/layoutOldHealthHistory"
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_height="wrap_content">

                <ProgressBar
                    android:id="@+id/oldProgressBar"
                    android:layout_width="50dp"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="50dp"/>

            </LinearLayout>
        </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
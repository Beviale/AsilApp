<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.home.DetailHealthHistoryFragment">


    <TextView
        android:id="@+id/detailHealthHistoryTitle"
        android:layout_width="270dp"
        android:layout_height="103dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="20dp"
        android:fontFamily="@font/titillium_web_bold"
        android:text="Glucosio"
        android:textSize="@dimen/textDetailHealthHistoryTitle"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/iconDetailTitle"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iconDetailTitle"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="48dp"
        android:src="@drawable/medical_history"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </ImageView>

    <TextView
        android:id="@+id/lastRecordHealthHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/titillium_web_bold"
        android:text="@string/lastRecordHealtHistory"
        android:textSize="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/detailHealthHistoryTitle" />


    <TextView
        android:id="@+id/dateLastRecordHealthHistoryLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        android:text="@string/dateLastRecordHealthHistoryLabel"
        android:textSize="@dimen/valueDetailHealthHistory"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lastRecordHealthHistory" />

    <TextView
        android:id="@+id/dateLastRecordHealthHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:text="20/11/2023"
        android:textSize="@dimen/valueDetailHealthHistory"
        app:layout_constraintLeft_toRightOf="@+id/dateLastRecordHealthHistoryLabel"
        app:layout_constraintTop_toBottomOf="@+id/lastRecordHealthHistory" />


    <TextView
        android:id="@+id/timeLastRecordHealthHistoryLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        android:text="@string/timeLastRecordHealthHistoryLabel"
        android:textSize="@dimen/valueDetailHealthHistory"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dateLastRecordHealthHistory" />

    <TextView
        android:id="@+id/timeLastRecordHealthHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:text="18:28"
        android:textSize="@dimen/valueDetailHealthHistory"
        app:layout_constraintLeft_toRightOf="@+id/timeLastRecordHealthHistoryLabel"
        app:layout_constraintTop_toBottomOf="@+id/dateLastRecordHealthHistory" />



    <TextView
        android:id="@+id/valueLastRecordHealthHistoryLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        android:text="@string/valueLastRecordHealthHistoryLabel"
        android:textSize="@dimen/valueDetailHealthHistory"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timeLastRecordHealthHistory" />

    <TextView
        android:id="@+id/valueLastRecordHealthHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:text="48"
        android:textSize="@dimen/valueDetailHealthHistory"
        app:layout_constraintLeft_toRightOf="@+id/valueLastRecordHealthHistoryLabel"
        app:layout_constraintTop_toBottomOf="@+id/timeLastRecordHealthHistory" />

    <TextView
        android:id="@+id/unityDetaildHealthHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="5dp"
        android:text="@string/unityTemperature"
        android:textSize="@dimen/valueDetailHealthHistory"
        app:layout_constraintLeft_toRightOf="@+id/valueLastRecordHealthHistory"
        app:layout_constraintTop_toBottomOf="@+id/timeLastRecordHealthHistory" />


</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".controller.user.home.MedicalParametersFragment">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutUserDoctor"
        app:tabSelectedTextColor="@color/appMainColor"
        app:tabIndicatorColor="@color/appMainColor"
        app:tabRippleColor="@color/appMainColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.tabs.TabItem
            android:id="@+id/infoUserTabItem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/profileTitle" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/healthHistoryUserTabItem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/healthHistory" />


        <com.google.android.material.tabs.TabItem
            android:id="@+id/pathologiesUserTabItem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/pathologies" />
    </com.google.android.material.tabs.TabLayout>




    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/userDoctorTabFragmentContainer"
        android:layout_width="match_parent"
        android:layout_weight="2"
        android:layout_height="match_parent"/>

    <View
        android:layout_width="match_parent"
        android:elevation="10dp"
        android:layout_height="match_parent"
        android:layout_weight="17" />


</LinearLayout>
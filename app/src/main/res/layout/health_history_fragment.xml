<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.home.HealthHistoryFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bodyTemperatureView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/heightHealthHistory"
        android:layout_marginStart="24dp"
        android:background="@color/colorHealthHistory"
        android:layout_marginTop="40dp"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/titillium_web_bold"
            android:layout_marginLeft="20dp"
            android:text="@string/temperatureHealthHistory"
            android:textSize="@dimen/textHealthHistory"
            android:textColor="@color/white"/>


        <TextView
            android:id="@+id/resultTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/titillium_web_bold"
            android:text="36°"
            android:textColor="@color/white"
            android:textSize="@dimen/resultHealthHistory"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent" />


        <TextView
            android:id="@+id/stateHealthHistoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginBottom="25dp"
            android:text="Stato: "
            android:textColor="@color/white"
            android:textSize="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent" />


        <TextView
            android:id="@+id/stateHealthHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:text="Buono 🟢"
            android:textColor="@color/white"
            android:textSize="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toEndOf="@+id/stateHealthHistoryLabel" />

        <TextView
            android:id="@+id/lastRecordTemperatureLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lastRecordLabel"
            android:textColor="@color/white"
            android:textSize="10dp"
            android:layout_marginLeft="20dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent" />

        <TextView
            android:id="@+id/lastRecordTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20/11/2023"
            android:textColor="@color/white"
            android:textSize="10dp"
            android:layout_marginLeft="2dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/lastRecordTemperatureLabel" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bloodPressureView"
        android:layout_width="match_parent"
        android:background="@color/colorHealthHistory"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:layout_height="@dimen/heightHealthHistory"
        android:layout_marginStart="@dimen/marginHealthHistory"
        android:layout_marginTop="@dimen/marginTopHealthHistory"
        android:layout_marginEnd="@dimen/marginHealthHistory"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        android:layout_marginLeft="@dimen/marginBetweenInputs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bodyTemperatureView">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/bloodPressureView"
        app:layout_constraintLeft_toLeftOf="@+id/bloodPressureView"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        android:fontFamily="@font/titillium_web_bold"
        android:text="@string/bloodPressureHealthHistory"
        android:textSize="@dimen/textHealthHistory"
        android:textColor="@color/white"/>

        <TextView
            android:id="@+id/unityBloodPressure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/titillium_web_bold"
            android:text="mmHg"
            android:textColor="@color/white"
            android:textSize="@dimen/resultUnityHealthHistory"
            app:layout_constraintTop_toBottomOf="@+id/resultBloodPressureMax"
            app:layout_constraintRight_toRightOf="parent" />

        <TextView
            android:id="@+id/resultBloodPressureMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/titillium_web_bold"
            android:text="120/"
            android:textColor="@color/white"
            android:textSize="@dimen/resultMaxPressureHealthHistory"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/unityBloodPressure" />

        <TextView
            android:id="@+id/resultBloodPressureMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:fontFamily="@font/titillium_web_bold"
            android:text="50"
            android:textColor="@color/white"
            android:textSize="@dimen/resultMinPressureHealthHistory"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/resultBloodPressureMax" />

        <TextView
            android:id="@+id/lastRecordBloodPressureLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/titillium_web_bold"
            android:text="@string/lastRecordLabel"
            android:textColor="@color/white"
            android:textSize="10dp"
            android:layout_marginLeft="20dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent" />

        <TextView
            android:id="@+id/lastRecordBloodPressure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/titillium_web_bold"
            android:text="20/11/2023"
            android:textColor="@color/white"
            android:textSize="10dp"
            android:layout_marginLeft="2dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/lastRecordBloodPressureLabel" />
    </androidx.constraintlayout.widget.ConstraintLayout>




    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/weightView"
        android:layout_width="match_parent"
        android:background="@color/colorHealthHistory"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:layout_height="@dimen/heightHealthHistory"
        android:layout_marginStart="@dimen/marginHealthHistory"
        android:layout_marginTop="@dimen/marginTopHealthHistory"
        android:layout_marginEnd="@dimen/marginHealthHistory"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        android:layout_marginLeft="@dimen/marginBetweenInputs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bloodPressureView">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="20dp"
            android:fontFamily="@font/titillium_web_bold"
            android:text="@string/weightHealthHistory"
            android:textSize="@dimen/textHealthHistory"
            android:textColor="@color/white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>




    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bpmView"
        android:layout_width="match_parent"
        android:background="@color/colorHealthHistory"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:layout_height="@dimen/heightHealthHistory"
        android:layout_marginStart="@dimen/marginHealthHistory"
        android:layout_marginTop="@dimen/marginTopHealthHistory"
        android:layout_marginEnd="@dimen/marginHealthHistory"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        android:layout_marginLeft="@dimen/marginBetweenInputs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/weightView">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="20dp"
            android:fontFamily="@font/titillium_web_bold"
            android:text="@string/bpmHealthHistory"
            android:textSize="@dimen/textHealthHistory"
            android:textColor="@color/white"/>

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>


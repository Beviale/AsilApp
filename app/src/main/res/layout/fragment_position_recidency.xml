<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".controller.user.home.MyRecidencyFragment">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:src="@mipmap/residency_home"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/nome_residenza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="2dp"
        android:layout_marginTop="-25dp"
        android:fontFamily="@font/titillium_web_bold"
        android:text="NOME RESIDENZA"
        android:textSize="@dimen/textTitleHealthHistory"
        android:textStyle="bold"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.536"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView2" />

    <TextView
        android:id="@+id/whereILive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/titillium_web_bold"
        android:text="@string/whereILive"
        android:textSize="@dimen/title3FontSize"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nome_residenza" />

    <EditText
        android:id="@+id/residencyDescription"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="15dp"
        android:layout_marginHorizontal="10dp"
        android:layout_weight="1"
        android:background="@drawable/rounded"
        android:cursorVisible="true"
        android:editable="false"
        android:elevation="5dp"
        android:fadeScrollbars="false"
        android:gravity="top"
        android:padding="10dp"
        android:scrollbarAlwaysDrawHorizontalTrack="false"
        android:scrollbarAlwaysDrawVerticalTrack="false"
        android:scrollbars="vertical"
        android:textSize="@dimen/textSizeDoctorNotes"
        app:layout_constraintTop_toBottomOf="@id/whereILive"/>

    <TextView
        android:id="@+id/rules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/titillium_web_bold"
        android:text="@string/rulesAndMore"
        android:textSize="@dimen/title3FontSize"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/residencyDescription" />

    <ImageView
        android:id="@+id/housing_rules_pdf_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:src="@mipmap/pdf"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rules" />

    <TextView
        android:id="@+id/download_servizi_abitativi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/housingRules"
        android:textColor="@color/appMainColor"
        android:layout_marginStart="15dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toEndOf="@id/housing_rules_pdf_icon"
        app:layout_constraintTop_toTopOf="@id/housing_rules_pdf_icon"/>

    <ImageView
        android:id="@+id/doc_rules_pdf_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:src="@mipmap/pdf"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/housing_rules_pdf_icon" />

    <TextView
        android:id="@+id/download_documentazione"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/docRules"
        android:textColor="@color/appMainColor"
        android:layout_marginStart="15dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toEndOf="@id/doc_rules_pdf_icon"
        app:layout_constraintTop_toTopOf="@id/doc_rules_pdf_icon"/>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:src="@mipmap/residency_footer"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/doc_rules_pdf_icon"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
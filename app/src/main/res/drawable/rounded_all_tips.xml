<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#44000000" /> <!-- Semi-transparent black for shadow -->
            <corners android:radius="16dp" /> <!-- Adjust corner radius as needed -->
        </shape>
    </item>

    <!-- Card Background -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" /> <!-- Background color for the card -->
            <corners android:radius="16dp" /> <!-- Adjust corner radius as needed -->
        </shape>
    </item>

</layer-list>

<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AsilApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorAccent">@color/colorAccent</item>
    </style>


    <style name="AppTheme.ActionBarTheme" parent="@style/ThemeOverlay.AppCompat.ActionBar">
        <item name="actionOverflowButtonStyle">@style/actionOverflowButtonStyle</item> <!-- sets the style for the overflow button -->
    </style>

    <style name="actionOverflowButtonStyle" parent="@style/Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">@color/white</item>
    </style>

    <!--Per la finestra di dialogo classica-->
    <style name="DialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogButtonStyled</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogButtonStyled</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/DialogButtonStyled</item>
    </style>
    <style name="DialogButtonStyled" parent="Theme.MaterialComponents.Light">
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_marginLeft">10dp</item>
    </style>

    <!-- Per l'AutocompleteTextView -->
    <style name="MyAutoCompleteTextViewStyle" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox.Dense">
        <item name="android:popupBackground">@color/white</item>
    </style>
    <!-- Per l'AutocompleteTextView relativo alla data-->
    <style name="MyAutoCompleteTextViewStyleDate" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="android:popupBackground">@color/white</item>
    </style>


     <!-- Per gli Alert Dialog critici che prevedono un bottone positivo e uno negativo. -->
    <style name="CustomAlertDialogStyleCritical" parent="@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyleCritical</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyleCritical</item>
    </style>
    <style name="PositiveButtonStyleCritical" parent="@style/Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/red</item>
    </style>
    <style name="NegativeButtonStyleCritical" parent="@style/Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/appMainColor</item>
    </style>


    <!-- Per gli Alert Dialog che prevedono esclusivamente un bottone positivo -->
    <style name="CustomAlertDialogStyle" parent="@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
    </style>
    <style name="PositiveButtonStyle" parent="@style/Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/appMainColor</item>
    </style>


    <!-- Alert Dialog relativi alla condivisione dei dati -->
    <style name="CustomAlertDialogStyleShare" parent="@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyleShare</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyleShare</item>
    </style>
    <style name="PositiveButtonStyleShare" parent="@style/Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/colorDialogButton</item>
    </style>
    <style name="NegativeButtonStyleShare" parent="@style/Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/colorDialogButton</item>
    </style>



    <style name="Theme.AsilApp" parent="Base.Theme.AsilApp" />
</resources>